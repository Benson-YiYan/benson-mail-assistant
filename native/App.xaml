<Application
    x:Class="BensonMail.MailApp"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:BensonMail">
    <Application.Resources>
        <ResourceDictionary>
            <DataTemplate x:Key="MailReportTemplate" x:DataType="local:Report">
                <StackPanel Padding="4,12" Spacing="6">
                    <TextBlock Text="{x:Bind title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{x:Bind sender}" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{x:Bind time}" FontSize="12" Opacity="0.55"/>
                </StackPanel>
            </DataTemplate>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
